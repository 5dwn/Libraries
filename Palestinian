		if icon then
			mic = Instance.new('ImageLabel')
			mic.Size = UDim2.new(0, 16, 0, 16)
			mic.Position = UDim2.new(0, 10, 0.5, -8)
			mic.BackgroundTransparency = 1
			mic.Image = icon
			mic.ImageColor3 = Color3.fromRGB(120, 120, 120)
			mic.ZIndex = 5
			mic.Parent = master_btn
			label_x_offset = 32
		end

		local ml = Instance.new('TextLabel')
		ml.Size = UDim2.new(1, -label_x_offset - 24, 1, 0)
		ml.Position = UDim2.new(0, label_x_offset, 0, 0)
		ml.BackgroundTransparency = 1
		ml.Text = name
		ml.TextColor3 = Color3.fromRGB(120, 120, 120)
		ml.TextSize = 13
		ml.Font = Enum.Font.GothamMedium
		ml.TextXAlignment = Enum.TextXAlignment.Left
		ml.ZIndex = 5
		ml.Parent = master_btn

		master_btn.Parent = wrap

		local sub_holder = Instance.new('Frame')
		sub_holder.Name = 'SubTabs'
		sub_holder.BackgroundTransparency = 1
		sub_holder.Size = UDim2.new(1, -4, 0, 0)
		sub_holder.AutomaticSize = Enum.AutomaticSize.Y
		sub_holder.ClipsDescendants = true
		sub_holder.Visible = false
		sub_holder.ZIndex = 4
		sub_holder.LayoutOrder = 2
		sub_holder.Parent = wrap

		local spad = Instance.new('UIPadding')
