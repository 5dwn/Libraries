		text_viewport.BorderSizePixel = 0
		text_viewport.ClipsDescendants = true
		text_viewport.ZIndex = 9
		text_viewport.Parent = snippet

		local letter_labels = {}
		local letter_positions = {}
		local letter_widths = {}
		local letter_spacing = 1
		local letter_speed = 22
		local letters_initialized = false

		local function get_letters(text)
			local letters = {}
			for _, codepoint in utf8.codes(text) do
				table.insert(letters, utf8.char(codepoint))
			end
			return letters
		end

		local function rebuild_letters()
			for _, letter_label in ipairs(letter_labels) do
				letter_label:Destroy()
			end
			table.clear(letter_labels)
			table.clear(letter_positions)
			table.clear(letter_widths)
			letters_initialized = false

			for copy_index = 1, 3 do
				for _, character in ipairs(get_letters(snippet_text .. '   ')) do
					local character_size = TextService:GetTextSize(character, 11, Enum.Font.Code, Vector2.new(1000, 34))
					local character_width = math.max(character_size.X, TextService:GetTextSize('M', 11, Enum.Font.Code, Vector2.new(1000, 34)).X)

					local letter_label = Instance.new('TextLabel')
					letter_label.Name = 'Letter'
					letter_label.Size = UDim2.new(0, character_width, 1, 0)
					letter_label.Position = UDim2.new(0, 0, 0, 0)
					letter_label.BackgroundTransparency = 1
					letter_label.Text = character
					letter_label.TextColor3 = Color3.fromRGB(205, 210, 220)
					letter_label.TextTransparency = 1
					letter_label.TextSize = 11
					letter_label.Font = Enum.Font.Code
					letter_label.TextXAlignment = Enum.TextXAlignment.Left
					letter_label.TextYAlignment = Enum.TextYAlignment.Center
					letter_label.ZIndex = 10
					letter_label.Parent = text_viewport

					table.insert(letter_labels, letter_label)
					letter_widths[letter_label] = character_width
				end
			end
		end

		rebuild_letters()

		local copy_button = Instance.new('TextButton')
		copy_button.Name = 'Copy'
		copy_button.Size = UDim2.new(0, 72, 0, 26)
		copy_button.Position = UDim2.new(1, -80, 0.5, -13)
		copy_button.BackgroundColor3 = Color3.fromRGB(30, 31, 36)
		copy_button.BackgroundTransparency = 0.1
		copy_button.BorderSizePixel = 0
		copy_button.AutoButtonColor = false
		copy_button.Text = ''
		copy_button.ZIndex = 11
		copy_button.Parent = snippet
		create_round(copy_button, 6)

		local copy_icon = Instance.new('ImageLabel')
		copy_icon.Size = UDim2.new(0, 13, 0, 13)
		copy_icon.Position = UDim2.new(0, 8, 0.5, -6)
		copy_icon.BackgroundTransparency = 1
		copy_icon.Image = 'rbxassetid://10734941454'
		copy_icon.ImageColor3 = Color3.fromRGB(190, 195, 205)
		copy_icon.ZIndex = 12
		copy_icon.Parent = copy_button

		local copy_label = Instance.new('TextLabel')
		copy_label.Size = UDim2.new(1, -27, 1, 0)
		copy_label.Position = UDim2.new(0, 25, 0, 0)
		copy_label.BackgroundTransparency = 1
		copy_label.Text = 'Copy'
		copy_label.TextColor3 = Color3.fromRGB(220, 225, 235)
		copy_label.TextSize = 11
		copy_label.Font = Enum.Font.GothamMedium
		copy_label.ZIndex = 12
		copy_label.Parent = copy_button

		copy_button.MouseEnter:Connect(function()
			create_tween(copy_button, {BackgroundColor3 = Color3.fromRGB(45, 47, 54)}, 0.18)
		end)

		copy_button.MouseLeave:Connect(function()
			create_tween(copy_button, {BackgroundColor3 = Color3.fromRGB(30, 31, 36)}, 0.18)
		end)

		copy_button.MouseButton1Down:Connect(function()
			create_tween(copy_button, {BackgroundColor3 = Color3.fromRGB(20, 21, 25)}, 0.1)
		end)

		copy_button.MouseButton1Click:Connect(function()
			if type(setclipboard) == 'function' then
				setclipboard(copy_text)
			end

			copy_label.Text = 'Copied'
			create_tween(copy_button, {BackgroundColor3 = Color3.fromRGB(42, 76, 61)}, 0.15)

			task.delay(1.4, function()
				if copy_button.Parent then
					copy_label.Text = 'Copy'
					create_tween(copy_button, {BackgroundColor3 = Color3.fromRGB(30, 31, 36)}, 0.18)
				end
			end)
		end)

		task.spawn(function()
			while snippet.Parent do
				local delta_time = RunService.RenderStepped:Wait()
				local viewport_width = text_viewport.AbsoluteSize.X
				if viewport_width <= 0 or #letter_labels == 0 then
					continue
				end

				if not letters_initialized then
					local cursor_x = -20
					for _, letter_label in ipairs(letter_labels) do
						letter_positions[letter_label] = cursor_x
						letter_label.Position = UDim2.new(0, cursor_x, 0, 0)
						cursor_x += letter_widths[letter_label] + letter_spacing
					end
					letters_initialized = true
				end

				local rightmost_x = -math.huge
				for _, letter_label in ipairs(letter_labels) do
					local position_x = letter_positions[letter_label] - (letter_speed * delta_time)
					letter_positions[letter_label] = position_x
					letter_label.Position = UDim2.new(0, position_x, 0, 0)
					rightmost_x = math.max(rightmost_x, position_x + letter_widths[letter_label])
				end

				for _, letter_label in ipairs(letter_labels) do
					local position_x = letter_positions[letter_label]
					local letter_width = letter_widths[letter_label]

					if position_x + letter_width < 0 then
						position_x = rightmost_x + letter_spacing
						rightmost_x = position_x + letter_width
						letter_positions[letter_label] = position_x
						letter_label.Position = UDim2.new(0, position_x, 0, 0)
					end

					local entering_transparency = math.clamp(-position_x / 24, 0, 1)
					local leaving_transparency = math.clamp((position_x + letter_width - viewport_width) / 24, 0, 1)
					letter_label.TextTransparency = math.max(entering_transparency, leaving_transparency)
				end
			end
		end)

		return {
			Set = function(_, new_text)
				snippet_text = tostring(new_text or '')
				rebuild_letters()
			end,
			Get = function()
				return snippet_text
			end,
			Frame = snippet
		}
	end

