							table.remove(selected, index)

							is_selected = false

							create_tween(option_button, {BackgroundColor3 = Color3.fromRGB(8, 8, 8), BackgroundTransparency = 0.2}, 0.2)
							create_tween(option_label, {TextColor3 = Color3.fromRGB(120, 120, 120)}, 0.2)
							create_tween(option_highlight, {BackgroundTransparency = 1}, 0.3)
