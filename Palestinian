		function tab:create_keybind_setting(index)
			local lib = self.__library
			local title = index.title or 'Key'
			local callback = index.callback or function() end
			local default_key = index.default or Enum.KeyCode.LeftControl
			local current_key = default_key
			local waiting = false
			local listen_conn = nil
			local cfg_flag = index.config_flag

			if cfg_flag then
				lib.__config_flags[cfg_flag] = current_key.Name
				lib.__config_setters[cfg_flag] = function(v)
					if v == nil or v == '' then
						current_key = Enum.KeyCode.LeftControl
						key_text.Text = current_key.Name
						callback(current_key)
					else
						local kc = Enum.KeyCode[v]
						if kc then
							current_key = kc
							key_text.Text = kc.Name
							callback(current_key)
						end
					end
				end
			end

			local row = Instance.new('Frame')
			row.Name = 'KeybindSetting'
			row.Size = UDim2.new(1, 2, 0, 40)
