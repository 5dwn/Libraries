                current_tweens = {}
				is_animating = false
			end

			if not self.__minimized then
				is_animating = true
				self.__minimized = true

				original_size = main.Size
				original_position = main.Position

				if self.__current_tab and self.__current_tab.container then
					saved_scroll_positions[self.__current_tab.container] = self.__current_tab.container.CanvasPosition
				end

				main.ClipsDescendants = true

				local expand_tween = create_tween(main, {
                    Size = UDim2.new(original_size.X.Scale, original_size.X.Offset + 30, original_size.Y.Scale, original_size.Y.Offset + 30),
                    Position = UDim2.new(original_position.X.Scale, original_position.X.Offset - (30 / 2), original_position.Y.Scale, original_position.Y.Offset - (30 / 2))
				}, 0.35)

				table.insert(current_tweens, expand_tween)

				expand_tween.Completed:Connect(function()
					if not self.__minimized then
						is_animating = false
						main.ClipsDescendants = false

						return
					end

					local shrink_tween = create_tween(main, {
						Size = UDim2.new(0, 0, 0, 0),
                        Position = UDim2.new(original_position.X.Scale, original_position.X.Offset + (original_size.X.Offset / 2), original_position.Y.Scale, original_position.Y.Offset + (original_size.Y.Offset / 2)),
                        BackgroundTransparency = 1
					}, 0.3)

					table.insert(current_tweens, shrink_tween)

					shrink_tween.Completed:Connect(function()
						if self.__minimized then
							main.Visible = false
						else
							main.ClipsDescendants = false
						end

						is_animating = false
						current_tweens = {}
					end)
				end)
			else
				is_animating = true
				self.__minimized = false

				main.Size = UDim2.new(0, 0, 0, 0)
				main.Position = UDim2.new(original_position.X.Scale, original_position.X.Offset + (original_size.X.Offset / 2), original_position.Y.Scale, original_position.Y.Offset + (original_size.Y.Offset / 2))

				main.Visible = true
				main.BackgroundTransparency = 0.1
				main.ClipsDescendants = true

				local grow_tween = create_tween(main, {
					Size = original_size,
					Position = original_position
				}, 0.25)

				table.insert(current_tweens, grow_tween)

				grow_tween.Completed:Connect(function()
					main.ClipsDescendants = false

					if self.__current_tab and self.__current_tab.container then
						local container = self.__current_tab.container

						container.ScrollBarImageTransparency = 0
						container.Active = true
						container.ScrollingEnabled = true

						if saved_scroll_positions[container] then
							container.CanvasPosition = saved_scroll_positions[container]
						end
					end

					is_animating = false
					current_tweens = {}
				end)
			end
		end
	end))

