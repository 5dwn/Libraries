local CFG_SEP = '\x1E'

local function palestinian_cfg_flag(...)
	local parts = { ... }
	return table.concat(parts, CFG_SEP)
end

local function palestinian_cfg_last_segment(flag)
	if type(flag) ~= 'string' then
		return ''
	end
	local sep = CFG_SEP
	local start = 1
	local last = flag
	while true do
		local i, j = flag:find(sep, start, true)
		if not i then
			last = flag:sub(start)
			break
		end
		start = j + 1
	end
	return last
end

local function palestinian_migrate_config_keys(data)
	if type(data) ~= 'table' then
		return data
	end
	local out = {}
	for k, v in pairs(data) do
		if type(k) == 'string' then
			local nk = k
			nk = nk:gsub('^Main' .. CFG_SEP, 'Blatant' .. CFG_SEP, 1)
			nk = nk:gsub('^world' .. CFG_SEP, 'World' .. CFG_SEP, 1)
			nk = nk:gsub('^Tools' .. CFG_SEP, 'configs' .. CFG_SEP, 1)
			nk = nk:gsub('^Settings' .. CFG_SEP, 'configs' .. CFG_SEP, 1)
			out[nk] = v
		else
			out[k] = v
		end
	end
	return out
end

function Library:__coerce_config_value(flag, val)
	if val == nil then
		return val
	end
	local tail = palestinian_cfg_last_segment(flag)
	if tail == 'module_on' then
		if val == true or val == false then
			return val
		end
		if val == 1 or val == '1' or val == 'true' then
			return true
		end
		if val == 0 or val == '0' or val == 'false' then
			return false
		end
		return val
	end
	if tail == 'module_key' or flag == '__menu_key' then
		if val == false then
			return ''
		end
		if type(val) == 'string' then
			return val
		end
		if type(val) == 'number' then
			return tostring(val)
		end
		return val
	end
	if string.find(flag, CFG_SEP .. 'slider' .. CFG_SEP, 1, true) or string.find(flag, CFG_SEP .. 'tab_slider' .. CFG_SEP, 1, true) then
		if type(val) == 'number' then
			return val
		end
		if type(val) == 'string' then
			return tonumber(val)
		end
		return val
	end
	if tail == 'tab_checkbox' or string.find(flag, CFG_SEP .. 'checkbox' .. CFG_SEP, 1, true) then
		if val == true or val == false then
			return val
		end
		if val == 1 or val == '1' or val == 'true' then
			return true
		end
		if val == 0 or val == '0' or val == 'false' then
			return false
		end
		return val
	end
	return val
end

function Library:__config_key_priority(flag)
	if flag == '__menu_key' then
		return '\0000'
	end
	local tail = palestinian_cfg_last_segment(flag)
	if tail == 'module_on' then
		return '\0001' .. flag
	end
	if tail == 'module_key' then
		return '\0002' .. flag
	end
	return '\0009' .. flag
end

function Library:apply_config_data(data)
	if type(data) ~= 'table' then
		return
	end
	data = palestinian_migrate_config_keys(data)
	local keys = {}
	for k in pairs(data) do
		if type(k) == 'string' and self.__config_setters[k] then
			table.insert(keys, k)
		end
	end
	table.sort(keys, function(a, b)
		local pa, pb = self:__config_key_priority(a), self:__config_key_priority(b)
		if pa ~= pb then
			return pa < pb
		end
		return a < b
	end)
	for _, k in ipairs(keys) do
		local raw = data[k]
		local v = self:__coerce_config_value(k, raw)
		local setter = self.__config_setters[k]
		if setter then
			local arg = v
			if arg == nil then
				arg = raw
			end
			if arg ~= nil then
				pcall(function()
					setter(arg)
				end)
			end
		end
	end
	for k, v in pairs(data) do
		if type(k) == 'string' then
			local c = self:__coerce_config_value(k, v)
			self.__config_flags[k] = (c ~= nil) and c or v
		end
	end
end

local function create_tween(object, properties, duration)
	local tween = cloneref(game:GetService('TweenService')):Create(object, TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quint), properties)
	tween:Play()

	return tween
end

local function create_round(parent, radius)
	local corner = Instance.new('UICorner')

	corner.CornerRadius = UDim.new(0, radius or 8)
	corner.Parent = parent

	return corner
end

local function create_outline(parent)
	local outline = Instance.new('UIStroke')

    outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	outline.Color = Color3.fromRGB(35, 35, 35)
	outline.Thickness = 1
	outline.Parent = parent

	return outline
end

