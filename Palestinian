			slider_ball.ZIndex = 6
			slider_ball.Parent = slider_track
			create_round(slider_ball, 5)
			create_outline(slider_ball)

			local function update_slider(input)
				local position = math.clamp((input.Position.X - slider_track_bg.AbsolutePosition.X) / slider_track_bg.AbsoluteSize.X, 0, 1)

				value = math.floor(min + (max - min) * position)

				if rounding > 0 then
					value = math.floor(value / rounding) * rounding
				end

				value = math.clamp(value, min, max)
				value_label.Text = tostring(value)

				create_tween(slider_track, {Size = UDim2.new(position, 0, 1, 0)}, 0.1)

				callback(value)
				lib.__config_flags[flag_ts] = value
			end

			local function set_value(new_value)
				value = math.clamp(new_value, min, max)

				if rounding > 0 then
					value = math.floor(value / rounding) * rounding
				end

				value_label.Text = tostring(value)
				slider_track.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)

				callback(value)
				lib.__config_flags[flag_ts] = value
			end

			lib.__config_setters[flag_ts] = function(v)
				if type(v) == 'number' then
					set_value(v)
				end
			end

			set_value(default)

			slider_hitbox.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = true

					create_tween(slider_ball, {Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -6, 0.5, -6)}, 0.2)
					update_slider(input)
				end
			end)

			slider_hitbox.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 then
					dragging = false

					create_tween(slider_ball, {Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new(1, -5, 0.5, -5)}, 0.2)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
					update_slider(input)
				end
			end)

			table.insert(self.__library.__all_elements, {name = index.title, frame = slider_frame})

			return {
				Set = function(self, new_value)
					set_value(new_value)
				end
			}
		end

