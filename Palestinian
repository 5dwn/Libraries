						selected_label.Text = option

						create_tween(option_button, {BackgroundColor3 = Color3.fromRGB(20, 20, 20), BackgroundTransparency = 0.2}, 0.2)
						create_tween(option_label, {TextColor3 = Color3.fromRGB(255, 255, 255)}, 0.2)
						create_tween(option_highlight, {BackgroundTransparency = 0.1}, 0.3)

