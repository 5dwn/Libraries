		if not copy_text then
			local discord_link = snippet_text:match("discord%.gg/[%w%d%-]+") or snippet_text:match("https?://%S+")
			if discord_link then
				if not discord_link:find("^https?://") then
					copy_text = "https://" .. discord_link
				else
					copy_text = discord_link
				end
			else
				copy_text = snippet_text
			end
		end

		local snippet = Instance.new('Frame')
		snippet.Name = 'CodeSnippet'
