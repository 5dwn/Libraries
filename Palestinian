function update_notification_positions()
	for i, notify in ipairs(Notifications) do
		local target_y = -20

		for j = #Notifications, i + 1, -1 do
			if Notifications[j] and Notifications[j].AbsoluteSize then
				target_y = target_y - Notifications[j].AbsoluteSize.Y - 10
			end
		end

		if notify and notify.Parent then
			create_tween(notify, {Position = UDim2.new(1, -20, 1, target_y)}, 0.3)
		end
	end
end

