			key_btn.AnchorPoint = Vector2.new(0, 0.5)
			key_btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
			key_btn.BorderSizePixel = 0
			key_btn.Text = ''
			key_btn.AutoButtonColor = false
			key_btn.ZIndex = 5
			key_btn.Parent = row
			create_round(key_btn, 6)
			create_outline(key_btn)

			local key_text = Instance.new('TextLabel')
			key_text.Size = UDim2.new(1, 0, 1, 0)
			key_text.BackgroundTransparency = 1
			key_text.Text = current_key.Name
			key_text.TextColor3 = Color3.fromRGB(180, 180, 180)
			key_text.TextSize = 11
			key_text.Font = Enum.Font.GothamBold
			key_text.ZIndex = 6
			key_text.Parent = key_btn

			local function finish_listen()
				waiting = false
				if listen_conn then
					listen_conn:Disconnect()
					listen_conn = nil
				end
			end

			key_btn.MouseButton1Click:Connect(function()
				if waiting then
					finish_listen()
					key_text.Text = current_key.Name
					return
				end
				local frozen_key = current_key
				waiting = true
				key_text.Text = '...'
				listen_conn = UserInputService.InputBegan:Connect(function(input, process)
					if process then
						return
					end
					if input.UserInputType ~= Enum.UserInputType.Keyboard then
						return
					end
					if input.KeyCode == Enum.KeyCode.Unknown then
						return
					end
					if input.KeyCode == Enum.KeyCode.Backspace then
						finish_listen()
						current_key = frozen_key
						key_text.Text = current_key.Name
						return
					end
					finish_listen()
					current_key = input.KeyCode
					key_text.Text = current_key.Name
					if cfg_flag then
						lib.__config_flags[cfg_flag] = current_key.Name
					end
					callback(current_key)
				end)
			end)

			table.insert(self.__library.__all_elements, {name = title, frame = row})

			return {
				SetKey = function(_, key)
					current_key = key or Enum.KeyCode.LeftControl
					key_text.Text = current_key.Name
					if cfg_flag then
						lib.__config_flags[cfg_flag] = current_key.Name
					end
				end
			}
		end

