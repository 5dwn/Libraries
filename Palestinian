				end
			}
			lib.__config_setters[flag_td] = function(v)
				if multi_selection then
					if type(v) == 'table' then
						tab_drop_api.Set(tab_drop_api, v)
					end
				else
					tab_drop_api.Set(tab_drop_api, v)
				end
			end

			function tab_drop_api:Refresh(new_options)
				options_list = new_options or {}
				for _, ch in pairs(options_container:GetChildren()) do
					if ch:IsA('TextButton') then
						ch:Destroy()
					end
				end
				for _, opt in ipairs(options_list) do
					create_option(opt)
				end
				if not multi_selection then
					local found = false
					for _, o in ipairs(options_list) do
						if o == selected then
							found = true
							break
						end
					end
					if not found then
						selected = options_list[1] or '--'
						selected_label.Text = get_display_text()
						callback(selected)
					end
				end
				snapshot_tab_dropdown_flag()
			end

			return tab_drop_api
		end

		return tab
	end

